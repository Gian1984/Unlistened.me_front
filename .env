# API base URL used by src/services/api.js via runtimeConfig.public.apiBaseUrl.
# Point at your local Laravel backend (default Valet/Herd is http://localhost/).
# Comment-out the local line and uncomment the remote line to dev-against prod.
NUXT_PUBLIC_API_BASE_URL=http://localhost/
#NUXT_PUBLIC_API_BASE_URL=https://api.unlistened.me/

# Legacy pre-Nuxt vars (no longer read by the app, kept for reference)
#VITE_BASE_URL=http://localhost/
#VITE_BASE_URL="https://www.unlistened.me/backend/public/"
VITE_APP_TITLE=Unlistened.me
